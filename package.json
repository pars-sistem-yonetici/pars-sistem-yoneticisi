{
  "name": "pars-sistem-yoneticisi-ts",
  "version": "1.6.0",
  "private": true,
  "description": "Windows, macOS ve Linux için sistem bakım ve yazılım yöneticisi (TypeScript / Electron)",
  "license": "MIT",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && vite build",
    "dist": "npm run build && electron-builder",
    "dist:portable": "npm run build && electron-builder --dir",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "smoke:posix": "electron dist-electron/main/posix-smoke.js",
    "publish": "node scripts/publish-update.js",
    "build:blogger": "node scripts/build-blogger.js",
    "bump": "node scripts/bump-version.js"
  },
  "dependencies": {
    "lucide-react": "^1.81.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "build": {
    "appId": "com.local.parssistemyoneticisi",
    "productName": "Pars Sistem Yoneticisi",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "dist/**/*",
      "package.json",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "build/prereqs",
        "to": "prereqs",
        "filter": "**/*"
      },
      {
        "from": "build/updates",
        "to": "updates",
        "filter": "**/*"
      },
      {
        "from": "build/regfix",
        "to": "regfix",
        "filter": "**/*"
      },
      {
        "from": "build/icon.ico",
        "to": "icons/tray.ico"
      },
      {
        "from": "build/icon.png",
        "to": "icons/tray.png"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon-512.png",
      "artifactName": "Pars.Sistem.Yoneticisi-${version}-${arch}.${ext}",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "category": "public.app-category.utilities"
    },
    "dmg": {
      "title": "Pars Sistem Yoneticisi ${version}${arch}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon-512.png",
      "artifactName": "Pars.Sistem.Yoneticisi-${version}-${arch}.${ext}",
      "executableName": "ParsSistemYoneticisi",
      "category": "Utility",
      "synopsis": "System maintenance and software manager",
      "description": "Read-only POSIX system maintenance and software management panel.",
      "maintainer": "Pars Sistem Yoneticisi <umcullah@gmail.com>",
      "vendor": "Pars Sistem Yoneticisi",
      "desktop": {
        "Name": "Pars Sistem Yoneticisi",
        "Comment": "System maintenance and software manager",
        "Terminal": "false",
        "Type": "Application",
        "Categories": "Utility;"
      }
    },
    "appImage": {
      "artifactName": "Pars.Sistem.Yoneticisi-${version}-x64.AppImage"
    },
    "deb": {
      "artifactName": "Pars.Sistem.Yoneticisi-${version}-x64.deb"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pars Sistem Yoneticisi",
      "include": "build/nsis/old-version-check.nsh",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "ParsSistemYoneticisi-Portable.exe",
      "requestExecutionLevel": "admin"
    }
  },
  "allowScripts": {
    "electron@34.5.8": true,
    "esbuild@0.25.12": true
  }
}
